# Modèle de fichier .env - copier en .env et remplir, OU laisser le Vagrantfile
# créer .env automatiquement au premier `vagrant up` (mots de passe aléatoires).
# Le fichier .env n'est JAMAIS versionné (R7).

# --- Secrets ---
PG_APP_PASSWORD=a_remplacer
PG_REPL_PASSWORD=a_remplacer
GRAFANA_ADMIN_PASSWORD=a_remplacer
# 8 caractères au plus pour keepalived
KEEPALIVED_PASS=a_remplacer

# --- Paramètres (facultatifs, valeurs par défaut entre parenthèses) ---
# Décommenter pour changer. Une valeur par ligne, sans commentaire en fin de ligne.
# Numéro de groupe -> 192.168.60.0/24
# GROUPE=5
# Nombre de serveurs applicatifs (R3)
# NB_APP=2
# 1 = extension E1, répartiteur redondant
# AVEC_LB2=0
# 1 = extension E2, supervision
# AVEC_OBS=0
# 1 = pare-feu ufw sur chaque VM
# PAREFEU=0
